# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=helpdesk_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_too_to_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (Nodemailer) - example uses Gmail app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_NAME=IT Help Desk
FROM_EMAIL=your_email@gmail.com
IT_DEPARTMENT_EMAIL=itsupport@company.com

# File upload
MAX_FILE_SIZE_MB=10
